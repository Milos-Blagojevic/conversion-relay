# Copy to .env and fill in, then load it into the environment before `python -m relay serve`
# (the relay reads the process environment; it does not read .env itself).

# live (default) sends to the real platforms; sandbox simulates both in-process and ignores the
# platform settings below.
RELAY_MODE=live
# SQLite file. Defaults to relay.db (live) or sandbox.db (sandbox). A database stays in its mode.
RELAY_DB=relay.db

# Server-to-server key for POST /v1/events. Required to listen beyond localhost.
RELAY_API_KEY=
# HTTP basic auth password for the dashboard, /api, /demo and /docs. Required beyond localhost.
DASHBOARD_PASSWORD=
# Origins whose pages may POST browser beacons to /v1/beacons (comma separated).
ALLOWED_ORIGINS=https://shop.example

# Meta Conversions API. Both or neither.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional. v27.0 when empty.
META_API_VERSION=
# Optional, testing only: events show up under Events Manager > Test events and are not counted.
META_TEST_EVENT_CODE=
# Optional: ad account (with or without act_) for the conversions Meta reports per campaign.
META_AD_ACCOUNT_ID=
# Optional: the Insights action type the comparison counts.
META_ACTION_TYPE=offsite_conversion.fb_pixel_purchase

# Google: Data Manager API (delivery) and Google Ads API (reporting). The first five, or none.
GOOGLE_CUSTOMER_ID=
GOOGLE_CONVERSION_ACTION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: manager account the credentials sign in through.
GOOGLE_LOGIN_CUSTOMER_ID=
# Optional: needed only for the conversions Google Ads reports per campaign.
GOOGLE_DEVELOPER_TOKEN=
# Optional. v26 when empty.
GOOGLE_ADS_API_VERSION=
# Optional: 1 to have Google validate requests without ingesting them.
GOOGLE_VALIDATE_ONLY=
# Optional: relay event names sent to Google (comma separated). Purchase when empty.
GOOGLE_EVENTS=Purchase

# Monitoring
# Seconds between platform pulls. 900 live, 30 sandbox.
MONITOR_INTERVAL_SECONDS=
# Days a click stays eligible for the internal last-click attribution.
CLICK_LOOKBACK_DAYS=7
# Days of platform reports each pull fetches.
REPORT_DAYS=30
# The event the attribution comparison counts.
CONVERSION_EVENT=Purchase
# The ad accounts' time zone (IANA name). Meta and Google date their reports in it, so the dashboard's
# days follow it. Set both accounts to the same zone or the daily comparison for one of them shifts.
REPORT_TIMEZONE=UTC
